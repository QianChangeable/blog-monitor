{
  "name": "hexo-blog-widget",
  "productName": "Hexo 控制台",
  "version": "1.0.0",
  "private": true,
  "description": "Tiny Hexo control widget: open the live site, toggle the local preview in Edge, scaffold new posts.",
  "main": "main.js",
  "author": "qianchang",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "bench:memory": "bash scripts/memory-bench.sh",
    "dist:win": "electron-builder --win --publish never",
    "pack:mac": "bash scripts/build-mac-app.sh",
    "dist:mac:builder": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.qianchang.hexoblogwidget",
    "productName": "Hexo Widget",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "Hexo-Widget-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Hexo-Widget-${version}.${ext}"
    }
  }
}
